{
  "name": "@mydon/mcp",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "mydon": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "find dist -name '*.test.js' -print0 | xargs -0 --no-run-if-empty node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mydon/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3"
  }
}
